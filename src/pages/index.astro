---
import ToolLayout from '../layouts/ToolLayout.astro';
import ToolHeader from '../components/ToolHeader.tsx';
import ToolFooter from '../components/ToolFooter.tsx';
import SpeedChecker from '../components/SpeedChecker.tsx';

const TOOL_NAME = 'Website Speed Test';
const TOOL_DESCRIPTION = 'Free website performance analyzer — audit 25+ speed best practices, estimate your score, and get code fixes.';
const GITHUB_URL = 'https://github.com/aidenwood/aidxn-speed';
---

<ToolLayout title={`${TOOL_NAME} — Aidxn Design`} description={TOOL_DESCRIPTION}>
  <ToolHeader client:load toolName={TOOL_NAME} />

  <main class="mx-auto w-full max-w-[1920px] px-5 py-12 md:px-10 lg:px-16">
    <SpeedChecker client:load />
  </main>

  <ToolFooter client:load toolName={TOOL_NAME} githubUrl={GITHUB_URL} />
</ToolLayout>
